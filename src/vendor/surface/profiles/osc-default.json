      "control": "osc:/awj/layer/1/opacity",
      "label": "Opacity",
      "target": {
        "kind": "layer",
        "screen": "@selected",
        "preset": "@selected",
        "layer": "@strip",
        "param": "opacity.opacity"
      },
      "options": {
        "takeover": "jump"
      }
    },
    {
      "control": "osc:/awj/layer/1/select",
      "label": "Select",
      "target": {
        "kind": "action",
        "action": "selectLayer",
        "value": "@strip"
      }
    },
